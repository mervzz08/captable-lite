{
  "name": "captable-lite",
  "version": "1.0.0",
  "private": true,
  "description": "A minimalist, serverless cap table: append-only hash-chained ledger, exact-decimal math, vesting and SAFE/priced-round modeling. Runs entirely in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "1.5.0",
    "decimal.js": "10.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.3"
  }
}
